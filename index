.task{background:linear-gradient(145deg,#151b26,#111620);border-color:#202838;padding:11px}
.task:hover{border-color:#3b4760;box-shadow:0 8px 20px rgba(0,0,0,.18)}
.task.done{opacity:.48}.check{border-color:#46536a}.check.done{box-shadow:0 0 14px rgba(167,139,250,.22)}
.task-meta{margin-left:28px}.tag{border-color:#283247;background:#0b0f16}
.add-day{border-color:#2b3548;background:rgba(10,14,20,.45)}
.home-grid{margin:16px 0 20px;gap:12px}.mission-panel,.quest-panel{background:rgba(13,17,25,.92)}
.mission-panel{padding:19px}.daily-card{background:#0a0f16;border-color:#202838}.daily-card:hover{border-color:#39465d;transform:translateY(-1px)}
.daily-card{transition:.16s}.daily-card.done{box-shadow:inset 3px 0 0 var(--green)}
.quest-panel{padding:17px}.recent-achievement{border-color:#202838}
.history{background:rgba(13,17,25,.92)}.history-card,.dashboard-card{background:#0a0f16;border-color:#202838}
.modal{background:rgba(2,4,8,.82)}.modal-box{border-color:#2a3446;box-shadow:0 30px 100px rgba(0,0,0,.6)}
.input,.select{border-color:#253044;background:#090d14}.input:focus,.select:focus{border-color:rgba(167,139,250,.65);box-shadow:0 0 0 3px rgba(167,139,250,.08)}
</style>
</head>
<body>
<div class="app">
<header class="topbar">
  <div class="brand"><div class="brand-mark"><span class="nq-mark">NQ</span></div><div><div class="brand-name">NEKO<span class="neon-text">QUEST</span></div><div class="brand-sub">Organize. Complete. Level Up.</div></div></div>
  <div class="top-actions">
    <button class="action-btn ghost" onclick="openFocusModal()"><i class="fa-solid fa-stopwatch"></i> <span class="label">Modo Foco</span></button>
    <button class="action-btn ghost" onclick="openShopModal()"><i class="fa-solid fa-store"></i> <span class="label">Loja de XP</span></button>
    <button class="action-btn ghost" onclick="openThemeModal()"><i class="fa-solid fa-sliders"></i> <span class="label">Personalizar</span></button>
    <button class="action-btn ghost" onclick="openDashboardModal()"><i class="fa-solid fa-chart-line"></i> <span class="label">Perfil</span></button>
    <button class="action-btn ghost" onclick="openCalendarModal()"><i class="fa-regular fa-calendar"></i> <span class="label">Calendário</span></button>
    <button class="action-btn primary" onclick="openQuickAddModal()"><i class="fa-solid fa-plus"></i> <span class="label">Nova quest</span></button>
  </div>
</header>

<section class="hero">
  <div class="hero-card">
    <div class="hero-copy">
      <div class="eyebrow">Quest board</div>
      <h1>Seu dia. Suas quests.<br><span style="color:var(--accent)" class="neon-text">Seu level up.</span></h1>
      <p>Uma central pessoal de organização com estética gamer, progresso por XP e histórico para você enxergar sua evolução.</p>
      <div class="hero-stats"><div class="stat"><span>Quests</span><b id="stat-total">12</b></div><div class="stat"><span>Concluídas</span><b id="stat-done">5</b></div><div class="stat"><span>XP total</span><b id="stat-xp">1500</b></div></div>
      <div class="streak-badge"><i class="fa-solid fa-fire"></i><span id="hero-streak">3 dias de sequência</span></div>
    </div>
    <img class="hero-cat" id="hero-cat" src="watermarked_img_16359930143375210449.jpg" alt="Gatinho gamer pixelado">
  </div>
  <aside class="side-card">
    <div class="side-head"><div><div class="eyebrow">Player progress</div><div class="level" id="level-name">LVL 3</div><div class="muted" style="font-size:11px" id="level-next">1500 / 2500 XP</div></div><div class="cat-badge"><img id="mini-cat" src="watermarked_img_15625824495576732761.jpg" alt="Avatar Gatinho"></div></div>
    <div><div class="xp-row"><span>Progresso</span><b id="xp-percent">60%</b></div><div class="progress"><i id="xp-bar" style="width:60%"></i></div><div class="profile-line"><span class="profile-dot"></span><span id="player-title">Aventureiro</span><span style="margin-left:auto" id="streak-side">🔥 3 dias</span></div><div class="install-note">Os dados ficam salvos neste dispositivo.</div></div>
  </aside>
</section>

<section class="home-grid">
  <div class="mission-panel">
    <div class="mission-head">
      <div><div class="eyebrow">Daily run</div><div class="mission-title">Missões de hoje</div><div class="mission-sub" id="daily-sub">Complete suas quests e ganhe XP.</div></div>
      <div style="text-align:right"><div class="eyebrow">Progresso</div><strong id="daily-percent" style="font:700 18px 'Space Grotesk'">0%</strong></div>
    </div>
    <div class="mini-progress"><i id="daily-bar" style="width:0%"></i></div>
    <div id="daily-grid" class="daily-grid">
      <!-- Exemplo estático para visualização -->
      <div class="daily-card">
        <div class="daily-check"><i class="fa-solid fa-check"></i></div>
        <b>Estudar Lógica de Programação</b><small>150 XP</small>
      </div>
      <div class="daily-card done">
        <div class="daily-check"><i class="fa-solid fa-check"></i></div>
        <b>Beber 2L de Água</b><small>50 XP</small>
      </div>
    </div>
  </div>
  <aside class="quest-panel">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
      <div><div class="eyebrow">Companion</div><div class="cat-message" id="cat-message">Pronto para a próxima quest! Miau.</div></div>
      <img id="cat-react" class="cat-react" src="watermarked_img_7241091187440064829.jpg" alt="Companheiro gamer">
    </div>
    <div class="quest-panel-head" style="margin-top:15px;"><h3>Conquistas recentes</h3><span class="quest-stat" id="achievement-count">2 desbloqueadas</span></div>
    <div id="recent-achievements">
      <div class="recent-achievement">
        <div class="achievement-icon" style="background: var(--accent2); color: #000;"><i class="fa-solid fa-star"></i></div>
        <div><b>Primeiros Passos</b><small>Complete sua 1ª quest</small></div>
      </div>
    </div>
  </aside>
</section>

<!-- Modais Novos -->
<!-- Modal Modo Foco -->
<div id="focus-modal" class="modal">
  <div class="modal-box" style="text-align: center; max-width: 400px; border-color: var(--accent);">
    <div class="modal-head">
      <div><div class="eyebrow">Pomodoro Timer</div><h2 class="neon-text">Modo Foco</h2></div>
      <button class="close" onclick="closeModal('focus-modal'); stopTimer();"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="form" style="padding: 30px;">
      <div id="timer-display" style="font-size: 64px; font-weight: 800; color: var(--accent2); font-family: 'Space Grotesk'; letter-spacing: 2px;">25:00</div>
      <p style="color: var(--muted); font-size: 13px; margin: 15px 0;">Concentre-se em sua quest atual sem distrações.<br>Ganhe <b style="color: var(--green);">+150 XP</b> ao terminar!</p>
      <div class="form-actions" style="justify-content: center; gap: 15px; margin-top: 25px;">
        <button class="action-btn" onclick="stopTimer()">Parar</button>
        <button class="action-btn primary" id="btn-start-focus" onclick="startTimer()">Iniciar Foco</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Loja XP -->
<div id="shop-modal" class="modal">
  <div class="modal-box" style="max-width: 500px;">
    <div class="modal-head">
      <div><div class="eyebrow">Rewards & Cosmetics</div><h2 class="neon-text">Loja de XP</h2></div>
      <button class="close" onclick="closeModal('shop-modal')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div style="padding: 15px 18px; color: var(--muted); font-size: 13px; border-bottom: 1px solid var(--line);">
      Seu saldo atual: <strong style="color: var(--accent2); font-size: 16px;"><span id="shop-balance">1500</span> XP</strong>
    </div>
    <div class="form rep-grid">
       <div class="achievement" onclick="buyItem('Filtro Dourado', 500, 'gold-cat')">
         <div class="achievement-icon" style="background: var(--yellow); color: #000;"><i class="fa-solid fa-cat"></i></div>
         <div><b>Avatar Dourado</b><small style="color: var(--yellow);">Custa 500 XP</small></div>
       </div>
       <div class="achievement" onclick="buyItem('Modo Hacker', 800, 'hacker-mode')">
         <div class="achievement-icon" style="background: var(--green); color: #000;"><i class="fa-solid fa-terminal"></i></div>
         <div><b>Fonte Hacker</b><small style="color: var(--green);">Custa 800 XP</small></div>
       </div>
    </div>
  </div>
</div>
<!-- Fim dos Modais -->

<!-- Sistema de Toasts -->
<div id="toast-container" class="toast">Mensagem do sistema</div>

</div> <!-- Fim .app -->

<script>
// Mock de Variáveis Globais
let globalXP = 1500;
let timerInterval;
let timeLeft = 25 * 60; // 25 minutos em segundos
let isTimerRunning = false;

// Funções de UI Genéricas
function closeModal(id) {
  document.getElementById(id).classList.remove('active');
}
function openFocusModal() {
  document.getElementById('focus-modal').classList.add('active');
}
function openShopModal() {
  document.getElementById('shop-balance').innerText = globalXP;
  document.getElementById('shop-modal').classList.add('active');
}
function showToast(message, isSuccess = true) {
  const toast = document.getElementById('toast-container');
  toast.innerText = message;
  toast.style.borderLeftColor = isSuccess ? 'var(--green)' : 'var(--red)';
  toast.classList.add('show');
  setTimeout(() => {
    toast.classList.remove('show');
  }, 3000);
}

// Lógica do Sistema de XP
function updateXP(amount) {
  globalXP += amount;
  document.getElementById('stat-xp').innerText = globalXP;
  document.getElementById('shop-balance').innerText = globalXP;
  // Atualiza barra de progresso mockada
  let nextLevelXP = 2500;
  let pct = Math.min((globalXP / nextLevelXP) * 100, 100).toFixed(0);
  document.getElementById('level-next').innerText = `${globalXP} / ${nextLevelXP} XP`;
  document.getElementById('xp-percent').innerText = `${pct}%`;
  document.getElementById('xp-bar').style.width = `${pct}%`;
}

// Lógica da Loja de XP
function buyItem(itemName, cost, effectType) {
  if (globalXP >= cost) {
    updateXP(-cost);
    showToast(`Parabéns! Você adquiriu: ${itemName} (-${cost} XP)`);
    
    // Aplica o cosmético na UI
    if(effectType === 'gold-cat') {
       document.getElementById('mini-cat').style.filter = 'sepia(1) saturate(5) hue-rotate(10deg)';
    } else if (effectType === 'hacker-mode') {
       document.body.style.fontFamily = "'Courier New', Courier, monospace";
    }
  } else {
    showToast(`XP insuficiente para comprar ${itemName}. Faltam ${cost - globalXP} XP!`, false);
  }
}

// Lógica do Timer (Modo Foco)
function updateTimerDisplay() {
  let m = Math.floor(timeLeft / 60).toString().padStart(2, '0');
  let s = (timeLeft % 60).toString().padStart(2, '0');
  document.getElementById('timer-display').innerText = `${m}:${s}`;
}

function startTimer() {
  if (isTimerRunning) return;
  isTimerRunning = true;
  document.getElementById('btn-start-focus').innerText = "Focando...";
  
  timerInterval = setInterval(() => {
    if(timeLeft <= 0) {
      clearInterval(timerInterval);
      isTimerRunning = false;
      updateXP(150);
      showToast('Sessão de Foco concluída! Você ganhou +150 XP!');
      timeLeft = 25 * 60;
      updateTimerDisplay();
      document.getElementById('btn-start-focus').innerText = "Iniciar Foco";
      closeModal('focus-modal');
      return;
    }
    timeLeft--;
    updateTimerDisplay();
  }, 1000);
}

function stopTimer() {
  clearInterval(timerInterval);
  isTimerRunning = false;
  timeLeft = 25 * 60;
  updateTimerDisplay();
  document.getElementById('btn-start-focus').innerText = "Iniciar Foco";
}
</script>
</body>
</html>
